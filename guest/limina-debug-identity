#
# Print which limina host build this guest is running on, and this launch's facts, as
# `key=value` lines — read from the debug port the host exposes to every guest
# (docs/design/debug-port.md). Needs bash and nothing else; run as root (stock udev leaves
# /dev/vport* root-only).
#
#   limina-debug-identity            # the whole answer
#   limina-debug-identity launch_id  # one value
#
# Exit status: 0 on a full answer, 1 when the port is missing (not a limina guest, or a
# limina build without it), 2 when the host did not answer within the timeout, 3 when the
# answer has no such key, 4 when the host has the port's answers turned off (its debug-port
# lever; the message says how to turn it on).
set -u
PORT=/dev/virtio-ports/org.limina.debug.0
TIMEOUT=${LIMINA_DEBUG_TIMEOUT:-10}

[ -e "$PORT" ] || { echo "no $PORT: not running on a limina host with a debug port" >&2; exit 1; }
exec 3<>"$PORT" || exit 1
echo identity >&3

# The answer starts at `format=` and ends at a lone `.`. Anything before `format=` is the tail
# of an answer an earlier reader abandoned (the port is a byte stream that outlives readers).
started=
complete=
out=()
while IFS= read -r -t "$TIMEOUT" line <&3; do
  case $line in format=*) started=1 ;; esac
  [ -n "$started" ] || continue
  if [ "$line" = . ]; then complete=1; break; fi
  out+=("$line")
done
exec 3>&-
[ -n "$complete" ] || { echo "no complete answer on $PORT within ${TIMEOUT}s" >&2; exit 2; }

# Off by default on the host: every request is answered `error=disabled`, with `enable=` saying
# how to turn it on. Checked before any key lookup, so `limina-debug-identity launch_id` on a
# disabled port says so rather than "no such key".
for line in "${out[@]}"; do
  if [ "$line" = error=disabled ]; then
    echo "the limina debug port is disabled on the host" >&2
    for l in "${out[@]}"; do
      case $l in enable=*) echo "to enable it: ${l#enable=}" >&2 ;; esac
    done
    exit 4
  fi
done

if [ $# -gt 0 ]; then
  for line in "${out[@]}"; do
    [ "${line%%=*}" = "$1" ] && { echo "${line#*=}"; exit 0; }
  done
  exit 3
fi
printf '%s\n' "${out[@]}"
