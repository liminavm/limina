+static void virtio_gpu_cmd_limina_cb(struct virtio_gpu_device *vgdev,
+				     struct virtio_gpu_vbuffer *vbuf)
+{
+	struct virtio_gpu_limina_call *call = vbuf->resp_cb_data;
+
+	memcpy(call->resp, vbuf->resp_buf, call->resp_size);
+	complete(&call->done);
+}
+
+/*
+ * Sends a limina extension command and waits for its response. The wait is not interruptible:
+ * `call` lives on the caller's stack and the response callback writes into it.
+ */
+int virtio_gpu_cmd_limina(struct virtio_gpu_device *vgdev,
+			  struct virtio_gpu_limina_call *call)
+{
+	struct virtio_gpu_vbuffer *vbuf;
+	void *resp_buf = NULL;
+	void *cmd_p;
+	int ret;
+
+	if (call->resp_size > MAX_INLINE_RESP_SIZE) {
+		resp_buf = kzalloc(call->resp_size, GFP_KERNEL);
+		if (!resp_buf)
+			return -ENOMEM;
+	}
+	init_completion(&call->done);
+	cmd_p = virtio_gpu_alloc_cmd_resp(vgdev, virtio_gpu_cmd_limina_cb, &vbuf,
+					  call->cmd_size, call->resp_size, resp_buf);
+	memcpy(cmd_p, call->cmd, call->cmd_size);
+	vbuf->resp_cb_data = call;
+	/* On failure (an unplugged device) the buffer is already freed and no response will come. */
+	ret = virtio_gpu_queue_ctrl_buffer(vgdev, vbuf);
+	if (ret)
+		return ret;
+	virtio_gpu_notify(vgdev);
+	wait_for_completion(&call->done);
+	return 0;
+}
