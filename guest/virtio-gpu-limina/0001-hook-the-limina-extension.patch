+/*
+ * A vram object and its resource id, not yet created on the host: limina's surfaces are created
+ * by a command of their own. Set bo->created once a create has been sent, so that freeing the
+ * object sends the unref that returns the id.
+ */
+int virtio_gpu_vram_init(struct virtio_gpu_device *vgdev,
+			 struct virtio_gpu_object_params *params,
+			 struct virtio_gpu_object **bo_ptr)
+{
+	struct drm_gem_object *obj;
+	struct virtio_gpu_object_vram *vram;
+	int ret;
+
+	vram = kzalloc(sizeof(*vram), GFP_KERNEL);
+	if (!vram)
+		return -ENOMEM;
+
+	obj = &vram->base.base.base;
+	obj->funcs = &virtio_gpu_vram_funcs;
+
+	params->size = PAGE_ALIGN(params->size);
+	drm_gem_private_object_init(vgdev->ddev, obj, params->size);
+
+	ret = drm_gem_create_mmap_offset(obj);
+	if (ret)
+		goto err_release_obj;
+
+	ret = virtio_gpu_resource_id_get(vgdev, &vram->base.hw_res_handle);
+	if (ret)
+		goto err_release_obj;
+
+	*bo_ptr = &vram->base;
+	return 0;
+
+err_release_obj:
+	drm_gem_object_release(obj);
+	kfree(vram);
+	return ret;
+}
