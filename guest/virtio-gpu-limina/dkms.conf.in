# dkms.conf for limina-virtio-gpu-ext: the in-tree virtio-gpu driver plus the native-context
# extension. @VERSION@ is stamped by scripts/build-virtio-gpu-limina.sh.
#
# The module keeps the in-tree name so it shadows the in-tree driver from extra/. Without the
# extension's feature bit it behaves exactly as upstream; a build that fails on a future kernel
# leaves the in-tree driver in place.
PACKAGE_NAME="limina-virtio-gpu-ext"
PACKAGE_VERSION="@VERSION@"
BUILT_MODULE_NAME[0]="virtio-gpu"
DEST_MODULE_LOCATION[0]="/extra"
AUTOINSTALL="yes"
MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build modules"
CLEAN="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build clean"
