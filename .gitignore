# Disk images (large; kept locally, backup is the .xz). The suffixed forms matter:
# a bare `*.raw` does NOT cover the `.raw.pre-<something>.bak` snapshots we take before
# a risky in-place bake, and a `git add -A` at the repo root then tries to stage tens of
# gigabytes (this really happened, 2026-07-31).
*.raw
*.raw.*
*.raw.xz
*.qcow2
*.qcow2.*
*.img
*.img.*
*.iso
*.bak

# Regenerable trace fixtures for the replay tests (like the .raw images:
# kept locally; regenerate via spikes/trace-replay/capture-replay*.sh)
/fixtures/traces/*.trace
/fixtures/traces/*.gfxr

# Rust build artifacts
/target
/guest/target
/guest/*/target
**/*.rs.bk
Cargo.lock.orig

# Vendored / built native deps (libkrun, virglrenderer, etc.)
# For now these are research clones; later they become tracked submodules/patches.
/third_party/
/vendor-build

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Local environment overrides
.env
.env.local
__pycache__/

# spikes/kk-timestamp-probe build artifacts
spikes/kk-timestamp-probe/probe
spikes/kk-timestamp-probe/probe.dSYM/
spikes/kk-timestamp-probe/mtlprobe
spikes/kk-timestamp-probe/mtlprobe.dSYM/
spikes/kk-timestamp-probe/tsbench
spikes/kk-timestamp-probe/tsbench.dSYM/
spikes/venus-blob-fault/probe

# spikes/fn-key-probe build artifact (source + RESULTS.md are kept)
spikes/fn-key-probe/fnprobe
spikes/fn-key-probe/fnprobe.dSYM/

# spikes/venus-draw-probe + spikes/virgl-zink-kk build artifacts (sources are kept)
spikes/venus-draw-probe/xfb-oob-probe
spikes/virgl-zink-kk/iosurfpbo
spikes/virgl-zink-kk/timerprobe

# Debug bundles are always build output, wherever clang leaves them.
*.dSYM/

# spikes/venus-ring-fatal-timeout build artifacts
spikes/venus-ring-fatal-timeout/probe
spikes/venus-ring-fatal-timeout/probe.dSYM/
