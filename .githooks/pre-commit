# limina pre-commit: rustfmt + clippy must be clean for the code we own.
#
# Never touches third_party/ (vendored libkrun is built, not linted; our libkrun changes
# live in patches/libkrun/). Enable with: git config core.hooksPath .githooks
# (scripts/setup-hooks.sh does this). Bypass a single commit with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() {
    echo "pre-commit: FAILED — $1" >&2
    echo "            fix it, or bypass once with: git commit --no-verify" >&2
    exit 1
}

# --- Optional per-clone checks, run FIRST so they fail before the slow cargo passes. ---
# `<git-common-dir>/local-pre-commit` is never tracked, which is the point: a check whose
# CONTENT is specific to one machine (a private path or hostname deny-list, say) must not
# be published by the repository it guards. This dispatch carries none of that content.
# Common-dir, not --git-dir, so worktrees find the same hook.
local_hook="$(git rev-parse --git-common-dir)/local-pre-commit"
if [ -x "$local_hook" ]; then
    "$local_hook" || fail "local pre-commit check ($local_hook)"
fi

# --- rustfmt: build-free and fast, so check every workspace we own. ---
echo "pre-commit: cargo fmt --check (all crates)"
cargo fmt --check || fail "rustfmt — run 'cargo fmt'"
# Per-member, not `--all --manifest-path guest/Cargo.toml`: guest/Cargo.toml is a virtual
# workspace and cargo-fmt resolves --all through the path-dep limina-proto into the ROOT
# workspace, dragging third_party/ into the check. Member manifests stay scoped.
for g in guest/*/Cargo.toml; do
    cargo fmt --manifest-path "$g" --check || fail "rustfmt ($g) — run 'cargo fmt --manifest-path $g'"
done
for s in spikes/*/Cargo.toml; do
    cargo fmt --manifest-path "$s" --check || fail "rustfmt ($s) — run 'cargo fmt --manifest-path $s'"
done
# xtask is standalone (outside the workspace — see Cargo.toml's exclude note), so cover it here.
cargo fmt --manifest-path xtask/Cargo.toml --check || fail "rustfmt (xtask) — run 'cargo fmt --manifest-path xtask/Cargo.toml'"

# --- clippy on the SHIPPED code (-D warnings). Spikes are experimental and skipped here
#     to keep commits fast (m1-boot-internal would rebuild the whole libkrun stack). ---
echo "pre-commit: cargo clippy --workspace (-D warnings)"
cargo clippy --workspace --all-targets -- -D warnings || fail "clippy (workspace)"
echo "pre-commit: cargo clippy xtask (-D warnings)"
cargo clippy --manifest-path xtask/Cargo.toml --all-targets -- -D warnings || fail "clippy (xtask)"
echo "pre-commit: cargo clippy guest (-D warnings)"
cargo clippy --manifest-path guest/Cargo.toml --target aarch64-unknown-linux-musl --all-targets -- -D warnings \
    || fail "clippy (guest)"

echo "pre-commit: ok"
