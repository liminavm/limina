+      return true;
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      *mtl = GKVM_MTLPixelFormatBGRA8Unorm_sRGB;
+      return true;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+      *mtl = GKVM_MTLPixelFormatRGBA8Unorm;
+      return true;
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      *mtl = GKVM_MTLPixelFormatRGBA8Unorm_sRGB;
+      return true;
+   default:
+      return false;
+   }
