@@ -316,6 +326,53 @@ vkr_ring_relax(uint32_t *iter)
 #endif
 }
 
+/* task #42: choose the warm-plateau depth for the UPCOMING idle period from a longer-period
+ * PROFILE of the ring, not immediate gap history. Called once per drain with the drain time;
+ * it updates the profile (has the ring gone genuinely long-idle recently?) and returns the
+ * plateau depth for the next idle period.
+ *
+ * The insight: the expensive "plateau-walk" happens on the inter-frame idle gap, which FOLLOWS
+ * a burst — so immediate history (the just-ended gaps) can't predict it. But over a longer
+ * window the REGIME is obvious: a vsync-capped app goes long-idle once per frame (it has
+ * per-cycle slack), while a saturated, submit-latency-bound app (uncapped vkmark) never does.
+ * In the CAPPED/SLACK regime we coarsen EVERY gap — safe because the regime itself guarantees
+ * the <=640 us pickup latency is hidden by the slack (empirically: forcing the minimal plateau
+ * held a steady 60 fps). In the SATURATED regime we keep the full responsive plateau. The
+ * classifier: a long idle (>= long_idle_ns, a genuine vsync-like gap that no tight-submit
+ * workload produces) seen within the last slack_window_ns => capped => minimal plateau.
+ * Never changes when the ring parks (idle_timeout), so the guest notify handshake is untouched.
+ * Env-tunable for A/B. */
+static uint32_t
+vkr_ring_profile_warm_rungs(struct vkr_ring *ring, uint64_t drain_now)
+{
+   static int inited = 0;
+   static uint32_t warm_max = 16, warm_min = 2;
+   static uint64_t long_idle_ns = 2000000ull;      /* 2 ms: a genuine per-cycle idle gap */
+   static uint64_t slack_window_ns = 100000000ull; /* 100 ms (~6 frames): remember the regime */
+   if (!inited) {
+      const char *e;
+      if ((e = getenv("LIMINA_RELAX_WARM_MAX")))
+         warm_max = (uint32_t)atoi(e);
+      if ((e = getenv("LIMINA_RELAX_WARM_MIN")))
+         warm_min = (uint32_t)atoi(e);
+      if ((e = getenv("LIMINA_RELAX_LONG_IDLE_US")))
+         long_idle_ns = (uint64_t)atoi(e) * 1000ull;
+      if ((e = getenv("LIMINA_RELAX_SLACK_MS")))
+         slack_window_ns = (uint64_t)atoi(e) * 1000000ull;
+      inited = 1;
+   }
+
+   if (ring->relax_last_drain_ns &&
+       drain_now - ring->relax_last_drain_ns >= long_idle_ns)
+      ring->relax_last_long_idle_ns = drain_now;
+   ring->relax_last_drain_ns = drain_now;
+
+   return ring->relax_last_long_idle_ns &&
+                drain_now - ring->relax_last_long_idle_ns < slack_window_ns
+             ? warm_min
+             : warm_max;
+}
