+      if (limina_kk_rtlog_cached()) {
+         id<MTLTexture> c0 = desc.colorAttachments[0].texture;
+         id<MTLTexture> root = c0;
+         while (root && !root.buffer && root.parentTexture)
+            root = root.parentTexture;
+         if (c0) {
