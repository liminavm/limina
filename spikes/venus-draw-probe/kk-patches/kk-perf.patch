+static inline bool
+kk_limina_slimpush(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      /* Default ON (round 19; sized by per-set high-water mark, see
+       * limina_used_size); LIMINA_KK_SLIMPUSH=0 restores full-size uploads. */
+      const char *e = getenv("LIMINA_KK_SLIMPUSH");
+      v = !e || e[0] != '0';
+   }
