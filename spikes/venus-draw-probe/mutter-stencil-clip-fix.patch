index 721984e..5536037 100644
--- a/cogl/cogl/cogl-framebuffer.c
+++ b/cogl/cogl/cogl-framebuffer.c
@@ -1145,6 +1145,19 @@ cogl_framebuffer_get_alpha_bits (CoglFramebuffer *framebuffer)
   return bits.alpha;
 }
 
+int
+cogl_framebuffer_get_stencil_bits (CoglFramebuffer *framebuffer)
+{
+  /* Zero-initialized: the driver query can bail without writing (e.g. when the
+   * winsys bits query is unsupported), and "no stencil" is the conservative
+   * answer for callers deciding whether stencil-based clipping is usable. */
+  CoglFramebufferBits bits = {};
+
+  cogl_framebuffer_query_bits (framebuffer, &bits);
+
+  return bits.stencil;
+}
