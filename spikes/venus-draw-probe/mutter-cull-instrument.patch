diff --git a/clutter/clutter/clutter-actor.c b/clutter/clutter/clutter-actor.c
index 2cc2b44..8bd119e 100644
--- a/clutter/clutter/clutter-actor.c
+++ b/clutter/clutter/clutter-actor.c
@@ -3246,6 +3246,30 @@ cull_actor (ClutterActor        *self,
         break;
     }
 
+  /* [LIMINA-CULL] #32: log the cull verdict + eye-space bbox for search-bar-ish actors so a
+   * wrong OUT can be compared numerically against the frusta rects logged by the stage. */
+  if (G_UNLIKELY (getenv ("LIMINA_CULL_LOG")))
+    {
+      const char *gk_name = _clutter_actor_get_debug_name (self);
+      if (gk_name && (strstr (gk_name, "Entry") || strstr (gk_name, "earch")))
+        {
+          graphene_box_t gk_box;
+          graphene_point3d_t gk_min, gk_max;
+          int gk_n = priv->visible_paint_volume.is_2d ? 4 : 8;
+          graphene_box_init_from_points (&gk_box, gk_n,
+                                         priv->visible_paint_volume.vertices);
+          graphene_box_get_min (&gk_box, &gk_min);
+          graphene_box_get_max (&gk_box, &gk_max);
+          fprintf (stderr,
+                   "[LIMINA-CULL] %s result=%s box=(%.1f,%.1f,%.1f)..(%.1f,%.1f,%.1f) frusta=%u\n",
+                   gk_name,
+                   result == CLUTTER_CULL_RESULT_OUT ? "OUT" :
+                   (result == CLUTTER_CULL_RESULT_IN ? "IN" : "PARTIAL"),
+                   gk_min.x, gk_min.y, gk_min.z, gk_max.x, gk_max.y, gk_max.z,
+                   clip_frusta->len);
+        }
+    }
+
   *result_out = result;
 
   return TRUE;
