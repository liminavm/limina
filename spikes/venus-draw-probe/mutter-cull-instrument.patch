+             clip->x, clip->y, clip->width, clip->height,
+             p[0].x, p[0].y, p[0].z, p[2].x, p[2].y, p[2].z);
+
   graphene_frustum_init (frustum,
                          &planes[0], &planes[1],
                          &planes[2], &planes[3],
