From e12c40e5f57c817c347faf39eb3dfed46cdc4d13 Mon Sep 17 00:00:00 2001
From: Gustavo Noronha Silva <gustavo@noronha.dev.br>
Date: Fri, 16 Oct 2026 16:58:58 -0300
Subject: [PATCH 3/3] zink: populate shadow attachments before reducing the fb
 to flush clears

When it is not blitting, zink_flush_clears() reduces ctx->fb_state to the
attachments with pending clears, begins a renderpass to apply them, and
puts fb_state back by plain assignment. If one of those attachments is
an MSRTT one whose transient is invalid, begin_rendering() populates it
with a replicate blit inside that renderpass setup, and u_blitter's
framebuffer save/restore rebinds the reduced framebuffer through
zink_set_framebuffer_state(). Everything derived from the framebuffer
(transient_attachments and the rest) is then recomputed for the reduced
one, and the plain assignment restores none of it: an MSRTT attachment
without a pending clear drops out of transient_attachments, and its
invalidated transient is later loaded without a replicate blit.

Populate the transients the clears need before reducing the framebuffer,
so the blit rebinds the real one, and the renderpass on the reduced
framebuffer finds them valid and blits nothing.

Before the previous commits this path recursed instead, so this goes to
stable together with them.

Cc: mesa-stable
Assisted-by: Claude Code
Signed-off-by: Gustavo Noronha Silva <gustavo@noronha.dev.br>
---
 src/gallium/drivers/zink/zink_context.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/gallium/drivers/zink/zink_context.c b/src/gallium/drivers/zink/zink_context.c
index 727022f8d85..5c0cddeaf10 100644
--- a/src/gallium/drivers/zink/zink_context.c
+++ b/src/gallium/drivers/zink/zink_context.c
@@ -3773,6 +3773,21 @@ zink_flush_clears(struct zink_context *ctx)
    bool queries_disabled = ctx->queries_disabled;
    bool has_swapchain = ctx->has_swapchain;
    bool blitting = ctx->blitting;
+   if (!blitting && ctx->transient_msrtss && !screen->info.have_EXT_multisampled_render_to_single_sampled) {
+      /* populate the transients the clears below need while the whole fb is still
+       * bound: the replicate blit rebinds the fb, and rebinding the reduced one
+       * would leave all fb-derived state describing it
+       */
+      uint32_t shadow_mask = 0;
+      for (unsigned i = 0; i < ctx->fb_state.nr_cbufs; i++) {
+         struct zink_resource *res = zink_resource(ctx->fb_state.cbufs[i].texture);
+         if (res && res->valid && zink_fb_clear_enabled(ctx, i))
+            shadow_mask |= BITFIELD_BIT(i);
+      }
+      shadow_mask &= ctx->transient_attachments;
+      if (shadow_mask)
+         zink_render_attachment_shadow(ctx, shadow_mask);
+   }
    struct pipe_framebuffer_state fb = ctx->fb_state;
    if (!blitting) {
       for (unsigned i = 0; i < ctx->fb_state.nr_cbufs; i++) {
