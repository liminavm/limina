+   {"mtl_texture_get_props", MTL_TALLY_SYNC},
+   {"mtl_new_texture_view_with", MTL_TALLY_CREATE},
+   {"mtl_new_texture_view_with_no_swizzle", MTL_TALLY_CREATE},
+   {"mtl_new_texture_view_with_format", MTL_TALLY_CREATE},
+   {"mtl_texture_get_bytes", MTL_TALLY_SYNC},
+   {"mtl_texture_replace_region", MTL_TALLY_ASYNC},
+   {"mtl_limina_set_label", MTL_TALLY_DIAG}
+};
+
+static const char *class_names[MTL_TALLY_NCLASS] = {"async", "create", "sync", "local",
+                                                    "diag"};
+
+struct counters {
+   _Atomic uint64_t calls, wire, reply, ticks;
+};
+
+static struct counters counters[MTL_TALLY_N];
+static _Atomic uint64_t window_began;
+static uint64_t every_ticks;
+static uint64_t t_numer = 1, t_denom = 1;
+static __thread int depth;
+
+int mtl_tally_armed;
+
+__attribute__((constructor)) static void
+mtl_tally_init(void)
+{
+   const char *v = getenv("LIMINA_KK_BRIDGE_TALLY");
+   if (!v || !*v || !strcmp(v, "0"))
+      return;
+   long secs = strtol(v, NULL, 10);
+   if (secs <= 0)
+      secs = 5;
+   mach_timebase_info_data_t tb;
+   mach_timebase_info(&tb);
+   t_numer = tb.numer;
+   t_denom = tb.denom;
+   every_ticks = (uint64_t)secs * 1000000000ull * t_denom / t_numer;
+   atomic_store(&window_began, mach_absolute_time());
+   mtl_tally_armed = 1;
+   fprintf(stderr, "[kk-tally] bridge tally on: %d functions, reporting every %lds\n",
+           MTL_TALLY_N, secs);
+}
+
+static double
+ticks_to_s(uint64_t t)
+{
+   return (double)t * t_numer / t_denom / 1e9;
+}
+
+struct row {
+   int idx;
+   uint64_t calls, wire, reply, ticks;
+};
+
+static int
+by_calls(const void *a, const void *b)
+{
+   const struct row *x = a, *y = b;
+   return x->calls < y->calls ? 1 : x->calls > y->calls ? -1 : 0;
+}
+
+static void
+print_row(const char *tag, const struct row *r, double secs)
+{
+   fprintf(stderr,
+           "[kk-tally]   %-6s %-52s %-6s %9.0f/s wire %9.0f B/s reply %7.0f B/s %6.3f thread-s/s "
+           "%6.2f us/call\n",
+           tag, entries[r->idx].name, class_names[entries[r->idx].cls], r->calls / secs,
+           r->wire / secs, r->reply / secs, ticks_to_s(r->ticks) / secs,
+           r->calls ? ticks_to_s(r->ticks) * 1e6 / r->calls : 0.0);
+}
+
+static void
+report(uint64_t elapsed)
+{
+   static struct row rows[MTL_TALLY_N];
+   int n = 0;
+   uint64_t cls_calls[MTL_TALLY_NCLASS] = {0}, cls_wire[MTL_TALLY_NCLASS] = {0},
+            cls_reply[MTL_TALLY_NCLASS] = {0}, cls_ticks[MTL_TALLY_NCLASS] = {0};
+   for (int i = 0; i < MTL_TALLY_N; i++) {
+      struct row r = {
+         .idx = i,
+         .calls = atomic_exchange_explicit(&counters[i].calls, 0, memory_order_relaxed),
+         .wire = atomic_exchange_explicit(&counters[i].wire, 0, memory_order_relaxed),
+         .reply = atomic_exchange_explicit(&counters[i].reply, 0, memory_order_relaxed),
+         .ticks = atomic_exchange_explicit(&counters[i].ticks, 0, memory_order_relaxed),
+      };
+      if (!r.calls)
+         continue;
+      enum mtl_tally_class c = entries[i].cls;
+      cls_calls[c] += r.calls;
+      cls_wire[c] += r.wire;
+      cls_reply[c] += r.reply;
+      cls_ticks[c] += r.ticks;
+      rows[n++] = r;
+   }
+   double secs = ticks_to_s(elapsed);
+   if (secs <= 0)
+      secs = 1e-9;
+   uint64_t calls = 0, wire = 0, reply = 0, ticks = 0;
+   for (int c = 0; c < MTL_TALLY_NCLASS; c++) {
+      if (c == MTL_TALLY_DIAG || c == MTL_TALLY_LOCAL)
+         continue;
+      calls += cls_calls[c];
+      wire += cls_wire[c];
+      reply += cls_reply[c];
+      ticks += cls_ticks[c];
+   }
+   fprintf(stderr,
+           "[kk-tally] window %.1fs: %.0f msg/s, wire %.0f B/s (%.1f B/msg), reply %.0f B/s, "
+           "sync %.0f/s, bridge %.3f thread-s/s (excl. local+diag)\n",
+           secs, calls / secs, wire / secs, calls ? (double)wire / calls : 0.0, reply / secs,
+           cls_calls[MTL_TALLY_SYNC] / secs, ticks_to_s(ticks) / secs);
+   for (int c = 0; c < MTL_TALLY_NCLASS; c++) {
+      if (!cls_calls[c])
+         continue;
+      fprintf(stderr,
+              "[kk-tally]   class  %-6s %9.0f/s wire %9.0f B/s reply %7.0f B/s %6.3f thread-s/s\n",
+              class_names[c], cls_calls[c] / secs, cls_wire[c] / secs, cls_reply[c] / secs,
+              ticks_to_s(cls_ticks[c]) / secs);
+   }
+   /* Every function that ran, so the reader can fold and rank offline. */
+   qsort(rows, n, sizeof(rows[0]), by_calls);
+   for (int i = 0; i < n; i++)
+      print_row("fn", &rows[i], secs);
+}
+
+struct mtl_tally_scope
+mtl_tally_enter(int idx, uint64_t wire, uint64_t reply)
+{
+   if (depth++ > 0)
+      return (struct mtl_tally_scope){-2, 0};
+   atomic_fetch_add_explicit(&counters[idx].calls, 1, memory_order_relaxed);
+   atomic_fetch_add_explicit(&counters[idx].wire, wire, memory_order_relaxed);
+   atomic_fetch_add_explicit(&counters[idx].reply, reply, memory_order_relaxed);
+   return (struct mtl_tally_scope){idx, mach_absolute_time()};
+}
+
+void
+mtl_tally_exit(struct mtl_tally_scope *s)
+{
+   if (s->idx == -1)
+      return;
+   depth--;
+   if (s->idx < 0)
+      return;
+   uint64_t now = mach_absolute_time();
+   atomic_fetch_add_explicit(&counters[s->idx].ticks, now - s->t0, memory_order_relaxed);
+   uint64_t began = atomic_load_explicit(&window_began, memory_order_relaxed);
+   if (now - began < every_ticks)
+      return;
+   if (!atomic_compare_exchange_strong(&window_began, &began, now))
+      return;
+   report(now - began);
+}
diff --git a/src/kosmickrisp/bridge/mtl_tally.h b/src/kosmickrisp/bridge/mtl_tally.h
new file mode 100644
index 00000000000..0210981e17b
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_tally.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright © 2026 Gustavo Noronha Silva
+ *
+ * limina measurement spike (spikes/metal-bridge-tally): count every Metal bridge call, the
+ * bytes it would put on a guest->host wire, and the time spent inside it. Armed by
+ * LIMINA_KK_BRIDGE_TALLY=<seconds>; unset, each scope costs one load and one branch.
+ * Generated into the tree by gen_tally.py -- never commit this to limina-kk. */
+#pragma once
+
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum mtl_tally_class {
+   MTL_TALLY_ASYNC,
+   MTL_TALLY_CREATE,
+   MTL_TALLY_SYNC,
+   MTL_TALLY_LOCAL,
+   MTL_TALLY_DIAG,
+   MTL_TALLY_NCLASS,
+};
+
+struct mtl_tally_scope {
+   int idx; /* -1 when unarmed */
+   uint64_t t0;
+};
+
+extern int mtl_tally_armed;
+struct mtl_tally_scope mtl_tally_enter(int idx, uint64_t wire, uint64_t reply);
+void mtl_tally_exit(struct mtl_tally_scope *s);
+
+#define MTL_TALLY_SCOPE(idx, wire, reply)                                        \
+   struct mtl_tally_scope _mtl_tally                                           \
+      __attribute__((cleanup(mtl_tally_exit), unused)) =                       \
+         __builtin_expect(mtl_tally_armed != 0, 0)                             \
+            ? mtl_tally_enter((idx), (uint64_t)(wire), (uint64_t)(reply))      \
+            : (struct mtl_tally_scope){-1, 0}
+
+#ifdef __cplusplus
+}
+#endif
