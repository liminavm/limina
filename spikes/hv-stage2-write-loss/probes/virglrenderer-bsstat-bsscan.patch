+/* limina F1 probe (LIMINA_BS_SCAN): a bitstream buffer read all-zero from its guest pages, so
+ * find out where the guest's bytes actually are. Dumps the resource's iovecs (as merged runs),
+ * then scans every RESIDENT page of the worker's large mappings -- guest RAM -- for the frame's
+ * first bytes (LIMINA_BS_MAGIC, hex; default = the VP9 keyframe head of the test clip) and names
+ * the context resource whose iov owns each hit. A hit inside another resource means the guest
+ * wrote a different bo (or the host attached the wrong pages to this one); no hit at all means
+ * the write never reached guest RAM. Resident-only, so an untouched 8 GiB guest costs nothing. */
+static void limina_bs_scan(struct vrend_video_context *vctx, uint32_t handle,
+                           struct vrend_resource *res, uint32_t size)
+{
+#ifdef __APPLE__
+   const char *hex = getenv("LIMINA_BS_MAGIC");
+   uint8_t magic[32];
+   size_t mlen = 0;
+   if (!hex || !*hex)
+      hex = "82498342";
+   for (; mlen < sizeof(magic) && hex[2 * mlen] && hex[2 * mlen + 1]; mlen++) {
+      unsigned v;
+      char b[3] = { hex[2 * mlen], hex[2 * mlen + 1], 0 };
+      if (sscanf(b, "%x", &v) != 1)
+         break;
+      magic[mlen] = (uint8_t)v;
+   }
+   if (mlen < 4)
+      return;
+
+   size_t total = 0;
+   for (uint32_t k = 0; k < res->num_iovs; k++)
+      total += res->iov[k].iov_len;
+   virgl_warn("[BSSCAN] handle=%u size=%u iovs=%d backing=%zu bind=0x%x width0=%u magic=%s\n",
+              handle, size, res->num_iovs, total, res->base.bind, res->base.width0, hex);
+   {
+      const uint8_t *run_base = NULL;
+      size_t run_len = 0;
+      uint32_t run_first = 0;
+      for (uint32_t k = 0; k < res->num_iovs; k++) {
+         const uint8_t *b = res->iov[k].iov_base;
+         if (run_base && b == run_base + run_len) {
+            run_len += res->iov[k].iov_len;
+            continue;
+         }
+         if (run_base)
+            virgl_warn("[BSSCAN]   run hva=%p len=%zu iov %u..%u\n", (const void *)run_base,
+                       run_len, run_first, k - 1);
+         run_base = b;
+         run_len = res->iov[k].iov_len;
+         run_first = k;
+      }
+      if (run_base)
+         virgl_warn("[BSSCAN]   run hva=%p len=%zu iov %u..%u\n", (const void *)run_base,
+                    run_len, run_first, res->num_iovs - 1);
+   }
+
+   struct timespec t0, t1;
+   clock_gettime(CLOCK_MONOTONIC, &t0);
+   mach_vm_address_t addr = 0x1000;
+   size_t scanned = 0, regions = 0, pagesz = (size_t)getpagesize();
+   int hits = 0;
+   for (;;) {
+      mach_vm_size_t rsize = 0;
+      vm_region_basic_info_data_64_t info;
+      mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+      mach_port_t obj = MACH_PORT_NULL;
+      kern_return_t kr = mach_vm_region(mach_task_self(), &addr, &rsize, VM_REGION_BASIC_INFO_64,
+                                       (vm_region_info_t)&info, &cnt, &obj);
+      if (kr != KERN_SUCCESS)
+         break;
+      if (obj != MACH_PORT_NULL)
+         mach_port_deallocate(mach_task_self(), obj);
+      if ((info.protection & VM_PROT_READ) && rsize >= ((mach_vm_size_t)64 << 20)) {
+         size_t npages = (size_t)(rsize / pagesz);
+         char *vec = malloc(npages);
+         regions++;
+         if (vec && mincore((void *)(uintptr_t)addr, (size_t)rsize, vec) == 0) {
+            size_t p = 0;
+            while (p < npages) {
+               while (p < npages && !(vec[p] & MINCORE_INCORE))
+                  p++;
+               size_t q = p;
+               while (q < npages && (vec[q] & MINCORE_INCORE))
+                  q++;
+               if (q > p) {
+                  const uint8_t *cur = (const uint8_t *)(uintptr_t)addr + p * pagesz;
+                  size_t len = (q - p) * pagesz;
+                  scanned += len;
+                  while (len >= mlen) {
+                     const uint8_t *h = memmem(cur, len, magic, mlen);
+                     if (!h)
+                        break;
+                     if (hits < 32) {
+                        int idx = -1, mine = -1;
+                        size_t off = 0;
+                        uint32_t owner = vrend_renderer_ctx_res_owning_hva(vctx->ctx, h, &idx, &off);
+                        for (uint32_t k = 0; k < res->num_iovs; k++) {
+                           const uint8_t *b = res->iov[k].iov_base;
+                           if (h >= b && h < b + res->iov[k].iov_len)
+                              mine = (int)k;
+                        }
+                        virgl_warn("[BSSCAN] hit hva=%p pageoff=0x%zx owner_res=%u owner_iov=%d "
+                                   "owner_off=%zu this_res_iov=%d\n", (const void *)h,
+                                   (size_t)((uintptr_t)h & (pagesz - 1)), owner, idx, off, mine);
+                     }
+                     hits++;
+                     size_t adv = (size_t)(h - cur) + 1;
+                     cur += adv;
+                     len -= adv;
+                  }
+               }
+               p = q;
+            }
+         } else {
+            virgl_warn("[BSSCAN]   region %p+%llu: mincore failed\n", (void *)(uintptr_t)addr,
+                       (unsigned long long)rsize);
+         }
+         free(vec);
+      }
+      addr += rsize;
+   }
+   clock_gettime(CLOCK_MONOTONIC, &t1);
+   virgl_warn("[BSSCAN] done regions=%zu resident_scanned=%zu MiB hits=%d in %ld ms\n", regions,
+              scanned >> 20, hits,
+              (long)((t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000));
+#else
+   (void)vctx; (void)handle; (void)res; (void)size;
+#endif
+}
