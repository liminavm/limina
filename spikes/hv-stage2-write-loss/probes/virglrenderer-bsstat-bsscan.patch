+                            size_t l = res->iov[j].iov_len < left ? res->iov[j].iov_len : left;
+                            for (uintptr_t q = a & ~(uintptr_t)63; q < a + l; q += 64)
+                                __asm__ volatile("dc civac, %0" : : "r"(q) : "memory");
+                            left -= l;
+                        }
+                        __asm__ volatile("dsb sy" : : : "memory");
+                        vrend_read_from_iovec(res->iov, res->num_iovs, 0, res->ptr, buffer_sizes[i]);
+                        size_t nz2 = 0;
+                        for (size_t k = 0; k < buffer_sizes[i]; k++) nz2 += p8[k] != 0;
+                        virgl_warn("%s: bs res %d after dc civac re-read: nonzero=%zu/%u head %02x %02x %02x %02x\n",
+                                   __func__, buffer_handles[i], nz2, buffer_sizes[i], p8[0], p8[1], p8[2], p8[3]);
+                    }
+#endif
+                    if (getenv("LIMINA_BS_SCAN"))
+                        limina_bs_scan(ctx, buffer_handles[i], res, buffer_sizes[i]);
+                } else if (getenv("LIMINA_BS_SCAN") && getenv("LIMINA_BS_SCAN")[0] == '2' &&
+                           buffer_sizes[i] >= 65536) {
+                    /* positive control: where a keyframe that DID arrive lives in guest RAM */
+                    limina_bs_scan(ctx, buffer_handles[i], res, buffer_sizes[i]);
                 }
             }
         }
