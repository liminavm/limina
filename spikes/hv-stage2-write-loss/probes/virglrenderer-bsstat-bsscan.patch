+struct owning_hva_walk {
+   const uint8_t *hva;
+   uint32_t owner;
+   int iov_idx;
+   size_t iov_off;
+};
+
+static enum pipe_error owning_hva_cb(void *key, void *value, void *data)
+{
+   struct owning_hva_walk *w = data;
+   struct vrend_resource *res = value;
+   if (w->owner)
+      return PIPE_OK;
+   for (uint32_t k = 0; k < res->num_iovs; k++) {
+      const uint8_t *b = res->iov[k].iov_base;
+      if (w->hva >= b && w->hva < b + res->iov[k].iov_len) {
+         w->owner = (uint32_t)(uintptr_t)key;
+         w->iov_idx = (int)k;
+         w->iov_off = (size_t)(w->hva - b);
+         break;
+      }
+   }
+   return PIPE_OK;
+}
+
+uint32_t vrend_renderer_ctx_res_owning_hva(struct vrend_context *ctx, const void *hva,
+                                           int *iov_idx, size_t *iov_off)
+{
+   struct owning_hva_walk w = { .hva = hva, .iov_idx = -1 };
+   util_hash_table_foreach(ctx->res_hash, owning_hva_cb, &w);
+   if (iov_idx)
+      *iov_idx = w.iov_idx;
+   if (iov_off)
+      *iov_off = w.iov_off;
+   return w.owner;
+}
+
+/* limina F1 probe (LIMINA_BSXFER): every transfer touching a PIPE_BIND_CUSTOM buffer -- the video
+ * bitstream/desc staging buffers are the only ones -- with its direction, so a bitstream that
+ * arrives zero can be checked against what the guest said it did with that handle. */
+static bool limina_bsxfer_on(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("LIMINA_BSXFER") != NULL;
+   return on;
+}
