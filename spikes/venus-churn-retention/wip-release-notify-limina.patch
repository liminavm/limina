+    /// A guest release drops the surface outright, ahead of the cap. This is what makes retention
+    /// exact rather than merely bounded: without it the cache stays full of whole framebuffers the
+    /// guest has already finished with, and only eviction pressure ever frees one.
+    #[test]
+    fn a_released_id_is_dropped_and_re_resolves_afterwards() {
+        let mut cache = SurfaceStore::with_cap(FRAME_CACHE_CAP);
+        let mut resolves = 0;
+        let mut resolve = |cache: &mut SurfaceStore| {
+            cache.get_or_insert_with(7, || {
+                resolves += 1;
+                Some(make_surface())
+            })
+        };
+
+        assert!(resolve(&mut cache).is_some());
+        assert_eq!(cache.len(), 1);
+
+        cache.remove(7);
+        assert_eq!(cache.len(), 0, "a released id must not stay cached");
+
+        // And the store is left consistent: the id resolves again from scratch rather than
+        // returning a stale entry or wedging on the eviction order.
+        assert!(resolve(&mut cache).is_some());
+        assert_eq!(
+            resolves, 2,
+            "the released id should have been resolved again"
+        );
+        assert_eq!(cache.len(), 1);
+    }
+
+    /// Removing an id we never held must not disturb the eviction order — the worker reports every
