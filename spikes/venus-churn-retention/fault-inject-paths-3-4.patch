+    *
+    * The shipped config allocates NOTHING before the driver call (the KK-linear path
+    * allocates only after a successful create), so a failed create cannot strand anything —
+    * which means a green census would certify a vehicle that arms nothing. This synthesizes
+    * the class: take a host allocation BEFORE the create, then on failure either release it
+    * (=1, GREEN) or drop it on the floor (=2, RED, the classic dropped release).
+    *
+    *   LIMINA_FAULT_ERRPATH=1  allocate pre-create, free correctly on the error path
+    *   LIMINA_FAULT_ERRPATH=2  allocate pre-create, LEAK it on the error path
+    */
+   struct vkr_mtl_iosurface *limina_fault_surf = NULL;
+   if (ci && limina_fault_doomed_create(ci)) {
+      /* Fires ONLY for a create the vehicle marked doomed (the private modifier below), so
+       * arming it adds no allocation to any other traffic — the alternative, allocating for
+       * every create, would both drown the census and eat the path-4 budget. */
+      struct vkr_device *fault_dev = vkr_device_from_handle(args->device);
+      if (fault_dev && fault_dev->mtl_device && ci->extent.width && ci->extent.height) {
+         limina_fault_surf = vkr_mtl_iosurface_alloc(fault_dev->mtl_device,
+                                                     ci->extent.width, ci->extent.height,
+                                                     LIMINA_MTLPixelFormatBGRA8Unorm,
+                                                     (uint32_t)'BGRA', 4, 0);
+         vkr_log_error("[LIMINA-FAULT] pre-create IOSurface id=%u",
+                       limina_fault_surf ? limina_fault_surf->id : 0);
+      }
+   }
+#endif
