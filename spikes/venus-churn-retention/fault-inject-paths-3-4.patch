    struct vkr_image *limina_obj = vkr_image_create_and_add(dispatch->data, args);
 
+#ifdef __APPLE__
+   if (limina_fault_surf) {
+      /* The arm selector is a FILE, not an env var, so RED and GREEN run in one boot: a
+       * worker's environment is fixed at exec, and rebooting between arms would put a fresh
+       * guest, fresh contexts and a fresh census between two numbers meant to be compared. */
+      const bool leak =
+         args->ret != VK_SUCCESS && access("/tmp/limina-fault-leak-errpath", F_OK) == 0;
+      if (leak)
+         vkr_log_error("[LIMINA-FAULT] LEAKING IOSurface id=%u on ret=%d",
+                       limina_fault_surf->id, (int)args->ret);
+      else
+         vkr_mtl_iosurface_free(limina_fault_surf);
+   }
+#endif
