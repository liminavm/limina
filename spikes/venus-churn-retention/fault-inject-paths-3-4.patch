 #include "vulkan/vulkan_metal.h"
 #include "vkr_metal_helpers.h"
 
+/* FAULT INJECTION — matrix path 3. NOT shipped; see
+ * spikes/venus-churn-retention/fault-inject-paths-3-4.patch.
+ *
+ * The handshake between the vehicle and the injector: limina-testcomp's `badmod` mode asks for
+ * exactly this modifier, which no driver implements, so KosmicKrisp refuses the create with
+ * VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT. Matching on the value keeps the
+ * injection scoped to creates that are *about* to fail — no other traffic allocates anything
+ * extra, so the census stays readable and the path-4 budget stays untouched. */
+#include <unistd.h>
+#define LIMINA_FAULT_DOOMED_MODIFIER 0x00fedeadbeef0123ull
+
+static bool
+limina_fault_doomed_create(const VkImageCreateInfo *ci)
+{
+   const VkImageDrmFormatModifierListCreateInfoEXT *list = vkr_find_struct(
+      ci->pNext, VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT);
+   if (!list)
+      return false;
+   for (uint32_t i = 0; i < list->drmFormatModifierCount; i++)
+      if (list->pDrmFormatModifiers[i] == LIMINA_FAULT_DOOMED_MODIFIER)
+         return true;
+   return false;
+}
+
