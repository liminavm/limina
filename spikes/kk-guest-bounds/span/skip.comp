#version 450
// Binding 1 has no descriptors, so a write of three from binding 0 fills 0, 2 and 3.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) buffer O { uint o[]; };
layout(set = 0, binding = 2) readonly buffer A { uint a[]; };
layout(set = 0, binding = 3) readonly buffer B { uint b[]; };
void main() { o[0] = a[0]; o[1] = b[0]; }
