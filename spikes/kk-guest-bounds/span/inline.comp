#version 450
// Two 16-byte inline uniform blocks: a 32-byte write at binding 1 fills both.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) buffer O { uint o[]; };
layout(set = 0, binding = 1) uniform U1 { uvec4 u1; };
layout(set = 0, binding = 2) uniform U2 { uvec4 u2; };
void main() { o[0] = u1.x; o[1] = u2.x; }
