+
+static uint64_t
+take(_Atomic uint64_t *v)
+{
+   return atomic_exchange(v, 0);
+}
+
+void
+lmn_stats_maybe_print(void)
+{
+   if (!lmn_stats_on)
+      return;
+   uint64_t now = now_ns(), last = atomic_load(&lmn_stats.last_print);
+   if (now - last < 1000000000ull ||
+       !atomic_compare_exchange_strong(&lmn_stats.last_print, &last, now))
+      return;
+   struct lmn_stats *s = &lmn_stats;
+   char calls[512] = "";
+   size_t off = 0;
+   for (unsigned op = 0; op < 0x400; op++) {
+      uint64_t n = take(&s->call_n[op]), ns = take(&s->call_ns[op]);
+      if (n && off < sizeof(calls) - 48)
+         off += snprintf(calls + off, sizeof(calls) - off, " %03x:%llu/%lluus", op,
+                         (unsigned long long)n, (unsigned long long)(ns / 1000));
+   }
+   uint64_t wn = take(&s->wait_n), wns = take(&s->wait_ns);
+   uint64_t wt[4], ct[4];
+   for (int i = 0; i < 4; i++) {
+      wt[i] = take(&s->wait_tier[i]);
+      ct[i] = take(&s->comp_tier[i]);
+   }
+   uint64_t cn = take(&s->comp_n), cns = take(&s->comp_ns), cgpu = take(&s->comp_gpu_ns);
+   fprintf(stderr,
+           "[LIMINA-LMN-STATS] pid=%d commits=%llu | wait n=%llu %lluus tiers=%llu/%llu/%llu/%llu "
+           "| comp n=%llu lat=%lluus gpu=%lluus tiers=%llu/%llu/%llu/%llu | export=%llu fb=%llu "
+           "import=%llu/%lluus | calls%s\n",
+           (int)getpid(), (unsigned long long)take(&s->commits), (unsigned long long)wn,
+           (unsigned long long)(wns / 1000), (unsigned long long)wt[0], (unsigned long long)wt[1],
+           (unsigned long long)wt[2], (unsigned long long)wt[3], (unsigned long long)cn,
+           (unsigned long long)(cns / 1000), (unsigned long long)(cgpu / 1000),
+           (unsigned long long)ct[0], (unsigned long long)ct[1], (unsigned long long)ct[2],
+           (unsigned long long)ct[3], (unsigned long long)take(&s->export_n),
+           (unsigned long long)take(&s->export_fallback), (unsigned long long)take(&s->import_n),
+           (unsigned long long)(take(&s->import_ns) / 1000), calls);
+}
+
+void
+lmn_stats_import(uint64_t ns)
+{
+   atomic_fetch_add(&lmn_stats.import_n, 1);
+   atomic_fetch_add(&lmn_stats.import_ns, ns);
+}
