+/* SPIKE: wait accounting, LIMINA_LMN_STATS=1, one line a second. */
+struct lmn_stats {
+   _Atomic uint64_t commits;
+   _Atomic uint64_t call_n[0x400], call_ns[0x400];
+   _Atomic uint64_t wait_n, wait_ns, wait_tier[4];
+   _Atomic uint64_t comp_n, comp_ns, comp_gpu_ns, comp_tier[4];
+   _Atomic uint64_t export_n, export_fallback, import_n, import_ns;
+   _Atomic uint64_t last_print;
+};
+extern struct lmn_stats lmn_stats;
+extern bool lmn_stats_on;
+uint64_t lmn_now_ns(void);
+static inline unsigned
+lmn_tier(unsigned round)
+{
+   return round == 0 ? 0 : round < 64 ? 1 : round < 256 ? 2 : 3;
+}
+void lmn_stats_maybe_print(void);
+void lmn_stats_import(uint64_t ns);
+
