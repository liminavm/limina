+/// SPIKE: per-second stage timings, `LIMINA_GPU_HOST_STATS=1`. Times are CLOCK_UPTIME_RAW, the
+/// base of Metal's GPU timestamps.
+mod spike_stats {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+    pub static ON: AtomicBool = AtomicBool::new(false);
+    pub static COMMITS: AtomicU64 = AtomicU64::new(0);
+    pub static PARKS: AtomicU64 = AtomicU64::new(0);
+    pub static PARK_NS: AtomicU64 = AtomicU64::new(0);
+    pub static FB_N: AtomicU64 = AtomicU64::new(0);
+    pub static TO_START_NS: AtomicU64 = AtomicU64::new(0);
+    pub static GPU_NS: AtomicU64 = AtomicU64::new(0);
+    pub static END_TO_FB_NS: AtomicU64 = AtomicU64::new(0);
+    pub static COMMIT_TO_FB_NS: AtomicU64 = AtomicU64::new(0);
+    pub static EV_N: AtomicU64 = AtomicU64::new(0);
+    pub static EV_NS: AtomicU64 = AtomicU64::new(0);
+    pub static FIRST_CMD_NS: AtomicU64 = AtomicU64::new(0);
+    pub static LAST: AtomicU64 = AtomicU64::new(0);
+    pub fn now() -> f64 {
+        let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        // SAFETY: a valid out pointer.
+        unsafe { libc::clock_gettime(libc::CLOCK_UPTIME_RAW, &mut t) };
+        t.tv_sec as f64 + t.tv_nsec as f64 * 1e-9
+    }
+    pub fn ns(d: f64) -> u64 {
+        if d > 0.0 { (d * 1e9) as u64 } else { 0 }
+    }
+    pub fn add(a: &AtomicU64, v: u64) {
+        a.fetch_add(v, Relaxed);
+    }
+    pub fn maybe_print() {
+        let now = ns(now());
+        let last = LAST.load(Relaxed);
+        if now - last < 1_000_000_000 || LAST.compare_exchange(last, now, Relaxed, Relaxed).is_err() {
+            return;
+        }
+        let t = |a: &AtomicU64| a.swap(0, Relaxed);
+        let fb = t(&FB_N).max(1);
+        let ev = t(&EV_N);
+        eprintln!(
+            "[GPU-HOST-STATS] commits={} parks={} parked={}us | per commit: commit->gpu_start={}us gpu={}us gpu_end->feedback={}us commit->feedback={}us | events={} signal_encode->listener={}us/ev | first_cmd_after_park={}us/park",
+            t(&COMMITS), PARKS.load(Relaxed), t(&PARK_NS) / 1000,
+            t(&TO_START_NS) / fb / 1000, t(&GPU_NS) / fb / 1000, t(&END_TO_FB_NS) / fb / 1000,
+            t(&COMMIT_TO_FB_NS) / fb / 1000, ev, t(&EV_NS) / ev.max(1) / 1000,
+            t(&FIRST_CMD_NS) / PARKS.swap(0, Relaxed).max(1) / 1000,
+        );
+    }
+}
