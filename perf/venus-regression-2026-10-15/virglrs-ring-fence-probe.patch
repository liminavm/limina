+/// Where ring fences' time went over one window: arrival to retire, split into the empty submit,
+/// the wait for the ring's thread, and the wait for the queue.
+#[derive(Default)]
+struct FenceStats {
+    n: u64,
+    submit_us: u64,
+    queued_us: u64,
+    wait_us: u64,
+    total_us: u64,
+    max_us: u64,
+    /// Arrival to retire, bucketed at the bounds in [`FenceStats::BOUNDS_US`] and one past.
+    buckets: [u64; 8],
+    began: Option<std::time::Instant>,
+}
+
+impl FenceStats {
+    const BOUNDS_US: [u64; 7] = [50, 100, 200, 300, 500, 1000, 2000];
+    const WINDOW: u64 = 2000;
+
+    fn record(&mut self, ctx: ContextId, submit: u64, queued: u64, wait: u64) {
+        let total = submit + queued + wait;
+        let began = *self.began.get_or_insert_with(std::time::Instant::now);
+        self.n += 1;
+        self.submit_us += submit;
+        self.queued_us += queued;
+        self.wait_us += wait;
+        self.total_us += total;
+        self.max_us = self.max_us.max(total);
+        let b = Self::BOUNDS_US.iter().position(|&b| total < b).unwrap_or(Self::BOUNDS_US.len());
+        self.buckets[b] += 1;
+        if self.n == Self::WINDOW {
+            let secs = began.elapsed().as_secs_f64();
+            eprintln!(
+                "[virglrs] ctx {} ring fences: {} in {:.2}s ({:.0}/s); mean us submit {} queued {} \
+                 wait {} total {}, max {}; <50/100/200/300/500/1000/2000/more {:?}",
+                ctx.get(),
+                self.n,
+                secs,
+                self.n as f64 / secs,
+                self.submit_us / self.n,
+                self.queued_us / self.n,
+                self.wait_us / self.n,
+                self.total_us / self.n,
+                self.max_us,
+                self.buckets
+            );
+            *self = FenceStats::default();
+        }
+    }
 }
 
