+/// [`wait_out`] by polling the fence's status every `every`, for `VIRGLRS_RING_FENCE_POLL_US`.
+fn poll_out(
+    queue: &Arc<HostQueue>,
+    fence: VkFence,
+    every: std::time::Duration,
+    going: &AtomicBool,
+) -> bool {
+    let device = queue.fns.handle;
+    while going.load(Ordering::Acquire) {
+        // SAFETY: a fence this thread's queue made, on the device that made it.
+        let r = unsafe { (queue.fns.vkGetFenceStatus())(device, fence) };
+        match r {
+            VkResult::VK_SUCCESS => return true,
+            VkResult::VK_NOT_READY => std::thread::sleep(every),
+            _ => return false,
+        }
+    }
+    false
+}
