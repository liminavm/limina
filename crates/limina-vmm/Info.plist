<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Embedded into the limina-vmm Mach-O (__TEXT,__info_plist) by build.rs. A bundle's
       Info.plist only covers its MAIN executable (limina); the worker is a separate helper
       that is the process which actually opens CoreAudio for `--mic`, so macOS TCC needs the
       microphone usage string to live in the WORKER's own Info.plist — otherwise no prompt
       can be shown and mic access is silently denied.

       CFBundleIdentifier deliberately matches the app (build-app.sh also signs the worker
       with `-i eti.noronha.limina` + the team-pinned DR): TCC records the grant under the
       responsible app (eti.noronha.limina) but validates the ACCESSING binary — the worker —
       against the grant's csreq (identifier "eti.noronha.limina" and team WDNHP64H9G). Under
       a distinct id the worker fails that identifier clause and CoreAudio keeps delivering
       (unauthorized) silence even after the user allowed. -->
  <key>CFBundleIdentifier</key><string>eti.noronha.limina</string>
  <key>CFBundleName</key><string>Limina</string>
  <key>NSMicrophoneUsageDescription</key><string>Limina lets a virtual machine capture your microphone when you enable mic sharing for it.</string>
</dict>
</plist>
