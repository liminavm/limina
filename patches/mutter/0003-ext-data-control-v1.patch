diff --git a/src/wayland/meta-wayland-data-control.c b/src/wayland/meta-wayland-data-control.c
new file mode 100644
index 0000000..bd910de
--- /dev/null
+++ b/src/wayland/meta-wayland-data-control.c
@@ -0,0 +1,533 @@
+/*
