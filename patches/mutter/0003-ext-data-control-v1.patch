+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * ext-data-control-v1: clipboard/primary access for focusless clients
+ * (clipboard managers, VM guest agents). Server side of the wayland-protocols
+ * staging protocol; wired onto MetaSelection like the primary-selection
+ * device (meta-wayland-data-device-primary.c), minus the focus gating —
+ * every bound data-control device receives selection events immediately and
+ * on every owner change.
+ *
+ * Carried by limina (GNOME upstream declines data-control on privacy grounds,
+ * mutter#524): the limina guest agent uses this for host<->guest clipboard
+ * sync without holding a RemoteDesktop session (which keeps the screen-share
+ * indicator lit). No privileged-client gating: in a limina guest the
+ * compositor's clients are all the user's own.
+ */
+
+#include "config.h"
+
+#include <gio/gunixoutputstream.h>
+#include <unistd.h>
+
+#include "core/display-private.h"
+#include "core/meta-selection-private.h"
+#include "meta/meta-selection-source-memory.h"
+#include "wayland/meta-selection-source-wayland-private.h"
+#include "wayland/meta-wayland-data-control.h"
+#include "wayland/meta-wayland-data-offer.h"
+#include "wayland/meta-wayland-data-source.h"
+#include "wayland/meta-wayland-private.h"
+
+#include "ext-data-control-v1-server-protocol.h"
+
+typedef struct _MetaWaylandDataControl
+{
+  MetaWaylandCompositor *compositor;
+  /* Bound ext_data_control_device_v1 resources (no focus semantics). */
+  struct wl_list device_resource_list;
+  gulong selection_owner_signal_id;
+  /* The selection owners (per MetaSelectionType) set through this module,
+   * mirroring MetaWaylandDataDevicePrimary::owner. */
+  MetaSelectionSource *owners[META_N_SELECTION_TYPES];
+  MetaWaylandDataSource *data_sources[META_N_SELECTION_TYPES];
+} MetaWaylandDataControl;
+
+typedef struct _MetaWaylandDataSourceControl
+{
+  MetaWaylandDataSource parent;
+  /* Set once the source has been used in set_selection /
+   * set_primary_selection (further offers / reuse are protocol errors). */
+  gboolean used;
+} MetaWaylandDataSourceControl;
+
+#define META_TYPE_WAYLAND_DATA_SOURCE_CONTROL (meta_wayland_data_source_control_get_type ())
+G_DECLARE_FINAL_TYPE (MetaWaylandDataSourceControl,
+                      meta_wayland_data_source_control,
+                      META, WAYLAND_DATA_SOURCE_CONTROL,
+                      MetaWaylandDataSource)
+
+G_DEFINE_TYPE (MetaWaylandDataSourceControl, meta_wayland_data_source_control,
+               META_TYPE_WAYLAND_DATA_SOURCE)
+
+static MetaDisplay *
+display_from_data_control (MetaWaylandDataControl *data_control)
+{
+  MetaContext *context =
+    meta_wayland_compositor_get_context (data_control->compositor);
+
+  return meta_context_get_display (context);
+}
+
+/* ---- source ---- */
+
+static void
+control_source_offer (struct wl_client   *client,
+                      struct wl_resource *resource,
+                      const char         *type)
+{
+  MetaWaylandDataSourceControl *source = wl_resource_get_user_data (resource);
+
+  if (source->used)
+    {
+      wl_resource_post_error (resource,
+                              EXT_DATA_CONTROL_SOURCE_V1_ERROR_INVALID_OFFER,
+                              "offer sent after set_selection");
+      return;
+    }
+
+  if (!meta_wayland_data_source_add_mime_type (META_WAYLAND_DATA_SOURCE (source),
+                                               type))
+    wl_resource_post_no_memory (resource);
+}
+
+static void
+control_source_destroy (struct wl_client   *client,
+                        struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_data_control_source_v1_interface control_source_interface = {
+  control_source_offer,
+  control_source_destroy,
+};
+
+static void
+destroy_control_source (struct wl_resource *resource)
+{
+  MetaWaylandDataSource *source = wl_resource_get_user_data (resource);
+
+  meta_wayland_data_source_set_resource (source, NULL);
+  g_object_unref (source);
+}
+
+static void
+meta_wayland_data_source_control_send (MetaWaylandDataSource *source,
+                                       const gchar           *mime_type,
+                                       gint                   fd)
+{
+  struct wl_resource *resource = meta_wayland_data_source_get_resource (source);
+
+  ext_data_control_source_v1_send_send (resource, mime_type, fd);
+  close (fd);
+}
+
+static void
+meta_wayland_data_source_control_cancel (MetaWaylandDataSource *source)
+{
+  struct wl_resource *resource = meta_wayland_data_source_get_resource (source);
+
+  if (resource)
+    ext_data_control_source_v1_send_cancelled (resource);
+}
+
+static void
+meta_wayland_data_source_control_init (MetaWaylandDataSourceControl *source_control)
+{
+}
+
+static void
+meta_wayland_data_source_control_class_init (MetaWaylandDataSourceControlClass *klass)
+{
+  MetaWaylandDataSourceClass *data_source_class =
+    META_WAYLAND_DATA_SOURCE_CLASS (klass);
+
+  data_source_class->send = meta_wayland_data_source_control_send;
+  data_source_class->cancel = meta_wayland_data_source_control_cancel;
+}
+
+/* ---- offer ---- */
+
+static void
+transfer_cb (MetaSelection *selection,
+             GAsyncResult  *res,
+             GOutputStream *stream)
+{
+  GError *error = NULL;
+
+  if (!meta_selection_transfer_finish (selection, res, &error))
+    {
+      g_warning ("data-control: could not fetch selection data: %s",
+                 error->message);
+      g_error_free (error);
+    }
+
+  g_output_stream_close (stream, NULL, NULL);
+  g_object_unref (stream);
+}
+
+static void
+control_offer_receive (struct wl_client   *client,
+                       struct wl_resource *resource,
+                       const char         *mime_type,
+                       int32_t             fd)
+{
+  MetaWaylandDataOffer *offer = wl_resource_get_user_data (resource);
+  MetaContext *context =
+    meta_wayland_compositor_get_context (offer->compositor);
+  MetaDisplay *display = meta_context_get_display (context);
+  MetaSelection *selection = meta_display_get_selection (display);
+  GOutputStream *stream;
+  GList *mime_types;
+  gboolean found;
+
+  mime_types = meta_selection_get_mimetypes (selection, offer->selection_type);
+  found = g_list_find_custom (mime_types, mime_type,
+                              (GCompareFunc) g_strcmp0) != NULL;
+  g_list_free_full (mime_types, g_free);
+
+  if (!found)
+    {
+      close (fd);
+      return;
+    }
+
+  stream = g_unix_output_stream_new (fd, TRUE);
+  meta_selection_transfer_async (selection,
+                                 offer->selection_type,
+                                 mime_type,
+                                 -1,
+                                 stream,
+                                 NULL,
+                                 (GAsyncReadyCallback) transfer_cb,
+                                 stream);
+}
+
+static void
+control_offer_destroy (struct wl_client   *client,
+                       struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_data_control_offer_v1_interface control_offer_interface = {
+  control_offer_receive,
+  control_offer_destroy,
+};
+
+static void
+destroy_control_offer (struct wl_resource *resource)
+{
+  MetaWaylandDataOffer *offer = wl_resource_get_user_data (resource);
+
+  g_free (offer);
+}
+
+static struct wl_resource *
+create_and_send_control_offer (MetaWaylandDataControl *data_control,
+                               struct wl_resource     *device_resource,
+                               MetaSelectionType       selection_type)
+{
+  MetaDisplay *display = display_from_data_control (data_control);
+  MetaWaylandDataOffer *offer;
+  struct wl_resource *resource;
+  GList *mimetypes, *l;
+
+  mimetypes = meta_selection_get_mimetypes (meta_display_get_selection (display),
+                                            selection_type);
+  if (!mimetypes)
+    return NULL;
+
+  offer = g_new0 (MetaWaylandDataOffer, 1);
+  offer->compositor = data_control->compositor;
+  offer->selection_type = selection_type;
+  offer->resource =
+    wl_resource_create (wl_resource_get_client (device_resource),
+                        &ext_data_control_offer_v1_interface,
+                        wl_resource_get_version (device_resource), 0);
+  wl_resource_set_implementation (offer->resource,
+                                  &control_offer_interface,
+                                  offer,
+                                  destroy_control_offer);
+  resource = offer->resource;
+
+  ext_data_control_device_v1_send_data_offer (device_resource, resource);
+
+  for (l = mimetypes; l; l = l->next)
+    ext_data_control_offer_v1_send_offer (resource, l->data);
+
+  g_list_free_full (mimetypes, g_free);
+
+  return resource;
+}
+
+/* ---- device ---- */
+
+static void
+send_selection_for_type (MetaWaylandDataControl *data_control,
+                         struct wl_resource     *device_resource,
+                         MetaSelectionType       selection_type,
+                         gboolean                has_owner)
+{
+  struct wl_resource *offer = NULL;
+
+  if (has_owner)
+    {
+      offer = create_and_send_control_offer (data_control, device_resource,
+                                             selection_type);
+    }
+
+  if (selection_type == META_SELECTION_CLIPBOARD)
+    ext_data_control_device_v1_send_selection (device_resource, offer);
+  else if (selection_type == META_SELECTION_PRIMARY)
+    ext_data_control_device_v1_send_primary_selection (device_resource, offer);
+}
+
+static void
+data_source_destroyed (gpointer  data,
+                       GObject  *object_was_here)
+{
+  MetaWaylandDataControl *data_control = data;
+  MetaDisplay *display = display_from_data_control (data_control);
+  int i;
+
+  for (i = 0; i < META_N_SELECTION_TYPES; i++)
+    {
+      if (data_control->data_sources[i] == (MetaWaylandDataSource *) object_was_here)
+        {
+          data_control->data_sources[i] = NULL;
+          if (data_control->owners[i])
+            {
+              meta_selection_unset_owner (meta_display_get_selection (display),
+                                          i, data_control->owners[i]);
+              g_clear_object (&data_control->owners[i]);
+            }
+        }
+    }
+}
+
+static void
+data_control_set_selection (MetaWaylandDataControl *data_control,
+                            struct wl_resource     *device_resource,
+                            struct wl_resource     *source_resource,
+                            MetaSelectionType       selection_type)
+{
+  MetaDisplay *display = display_from_data_control (data_control);
+  MetaSelectionSource *selection_source;
+
+  if (data_control->data_sources[selection_type])
+    {
+      g_object_weak_unref (G_OBJECT (data_control->data_sources[selection_type]),
+                           data_source_destroyed,
+                           data_control);
+      data_control->data_sources[selection_type] = NULL;
+    }
+
+  if (source_resource)
+    {
+      MetaWaylandDataSourceControl *source_control =
+        wl_resource_get_user_data (source_resource);
+      MetaWaylandDataSource *source =
+        META_WAYLAND_DATA_SOURCE (source_control);
+
+      if (source_control->used)
+        {
+          wl_resource_post_error (device_resource,
+                                  EXT_DATA_CONTROL_DEVICE_V1_ERROR_USED_SOURCE,
+                                  "source was already used");
+          return;
+        }
+      source_control->used = TRUE;
+
+      data_control->data_sources[selection_type] = source;
+      g_object_weak_ref (G_OBJECT (source), data_source_destroyed, data_control);
+
+      selection_source = meta_selection_source_wayland_new (source);
+    }
+  else
+    {
+      selection_source = g_object_new (META_TYPE_SELECTION_SOURCE_MEMORY, NULL);
+    }
+
+  meta_selection_set_owner (meta_display_get_selection (display),
+                            selection_type, selection_source);
+  g_set_object (&data_control->owners[selection_type], selection_source);
+  g_object_unref (selection_source);
+}
+
+static void
+control_device_set_selection (struct wl_client   *client,
+                              struct wl_resource *resource,
+                              struct wl_resource *source_resource)
+{
+  MetaWaylandDataControl *data_control = wl_resource_get_user_data (resource);
+
+  data_control_set_selection (data_control, resource, source_resource,
+                              META_SELECTION_CLIPBOARD);
+}
+
+static void
+control_device_set_primary_selection (struct wl_client   *client,
+                                      struct wl_resource *resource,
+                                      struct wl_resource *source_resource)
+{
+  MetaWaylandDataControl *data_control = wl_resource_get_user_data (resource);
+
+  data_control_set_selection (data_control, resource, source_resource,
+                              META_SELECTION_PRIMARY);
+}
+
+static void
+control_device_destroy (struct wl_client   *client,
+                        struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_data_control_device_v1_interface control_device_interface = {
+  control_device_set_selection,
+  control_device_destroy,
+  control_device_set_primary_selection,
+};
+
+static void
+unbind_device_resource (struct wl_resource *resource)
+{
+  wl_list_remove (wl_resource_get_link (resource));
+}
+
+static void
+owner_changed_cb (MetaSelection          *selection,
+                  MetaSelectionType       selection_type,
+                  MetaSelectionSource    *new_owner,
+                  MetaWaylandDataControl *data_control)
+{
+  struct wl_resource *device_resource;
+
+  if (selection_type != META_SELECTION_CLIPBOARD &&
+      selection_type != META_SELECTION_PRIMARY)
+    return;
+
+  wl_resource_for_each (device_resource, &data_control->device_resource_list)
+    {
+      send_selection_for_type (data_control, device_resource, selection_type,
+                               new_owner != NULL);
+    }
+}
+
+static void
+ensure_owner_changed_handler_connected (MetaWaylandDataControl *data_control)
+{
+  MetaDisplay *display = display_from_data_control (data_control);
+
+  if (data_control->selection_owner_signal_id != 0)
+    return;
+
+  data_control->selection_owner_signal_id =
+    g_signal_connect (meta_display_get_selection (display),
+                      "owner-changed",
+                      G_CALLBACK (owner_changed_cb), data_control);
+}
+
+/* ---- manager ---- */
+
+static void
+control_manager_create_data_source (struct wl_client   *client,
+                                    struct wl_resource *manager_resource,
+                                    uint32_t            id)
+{
+  struct wl_resource *source_resource;
+  MetaWaylandDataSource *source;
+
+  source_resource =
+    wl_resource_create (client, &ext_data_control_source_v1_interface,
+                        wl_resource_get_version (manager_resource), id);
+  source = g_object_new (META_TYPE_WAYLAND_DATA_SOURCE_CONTROL, NULL);
+  meta_wayland_data_source_set_resource (source, source_resource);
+  wl_resource_set_implementation (source_resource, &control_source_interface,
+                                  source, destroy_control_source);
+}
+
+static void
+control_manager_get_data_device (struct wl_client   *client,
+                                 struct wl_resource *manager_resource,
+                                 uint32_t            id,
+                                 struct wl_resource *seat_resource)
+{
+  MetaWaylandDataControl *data_control =
+    wl_resource_get_user_data (manager_resource);
+  struct wl_resource *cr;
+
+  cr = wl_resource_create (client, &ext_data_control_device_v1_interface,
+                           wl_resource_get_version (manager_resource), id);
+  wl_resource_set_implementation (cr, &control_device_interface,
+                                  data_control, unbind_device_resource);
+  wl_list_insert (&data_control->device_resource_list,
+                  wl_resource_get_link (cr));
+
+  ensure_owner_changed_handler_connected (data_control);
+
+  /* Per spec, the current selections are advertised upon binding (the offer
+   * degrades to NULL inside when there is nothing to offer). */
+  send_selection_for_type (data_control, cr, META_SELECTION_CLIPBOARD, TRUE);
+  send_selection_for_type (data_control, cr, META_SELECTION_PRIMARY, TRUE);
+}
+
+static void
+control_manager_destroy (struct wl_client   *client,
+                         struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct ext_data_control_manager_v1_interface control_manager_interface = {
+  control_manager_create_data_source,
+  control_manager_get_data_device,
+  control_manager_destroy,
+};
+
+static void
+bind_control_manager (struct wl_client *client,
+                      void             *data,
+                      uint32_t          version,
+                      uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client,
+                                 &ext_data_control_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &control_manager_interface,
+                                  data, NULL);
+}
+
+void
+meta_wayland_data_control_init (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandDataControl *data_control;
+
+  data_control = g_new0 (MetaWaylandDataControl, 1);
+  data_control->compositor = compositor;
+  wl_list_init (&data_control->device_resource_list);
+
+  if (wl_global_create (compositor->wayland_display,
+                        &ext_data_control_manager_v1_interface,
+                        1, data_control, bind_control_manager) == NULL)
+    g_error ("Could not create ext-data-control manager global");
+}
