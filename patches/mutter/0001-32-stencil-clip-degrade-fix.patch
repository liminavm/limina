+++ b/cogl/cogl/driver/gl/cogl-clip-stack-gl.c
@@ -43,6 +43,30 @@
 #include "cogl/driver/gl/cogl-clip-stack-gl-private.h"
 #include "mtk/mtk.h"
 
+/* limina #32: stencil clipping silently no-ops on a framebuffer that has no stencil
+ * bits (seen with zink on venus/MoltenVK, where the EGL config advertises stencil=8
+ * but the winsys buffer comes up with GL_STENCIL_BITS=0). The clip-stack scissor is
+ * already set to the entry bounds (the region/rect extents), so skipping the stencil
+ * refinement degrades to a conservative superset clip instead of letting every draw
+ * escape the clip and flood the frame. */
+static gboolean
+has_stencil_buffer (CoglFramebuffer *framebuffer)
+{
+  if (cogl_framebuffer_get_stencil_bits (framebuffer) > 0)
+    return TRUE;
+
+  {
+    static gboolean warned = FALSE;
+    if (!warned)
+      {
+        g_warning ("Framebuffer has no stencil buffer; falling back to "
+                   "scissor-extents clipping (no stencil refinement)");
+        warned = TRUE;
+      }
+  }
+  return FALSE;
+}
