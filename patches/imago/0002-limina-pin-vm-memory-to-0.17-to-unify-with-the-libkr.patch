From 1132a7b2100678c8bf66f19b8e904446f30095a4 Mon Sep 17 00:00:00 2001
From: Gustavo Noronha Silva <gustavo@noronha.dev.br>
Date: Tue, 30 Jun 2026 16:35:49 -0300
Subject: [PATCH 2/2] limina: pin vm-memory to ^0.17 to unify with the libkrun
 stack

Upstream imago allows vm-memory ">=0.16, <0.19". In limina's build graph the whole
libkrun stack (krun-arch/devices/hvf/vmm) is on vm-memory ^0.17, and krun-devices
hands imago a 0.17 VolatileSlice. With the loose range the resolver picks a
semver-incompatible vm-memory for imago (0.16 or 0.18), so that VolatileSlice fails
the `ImagoAsRef` bound and krun-devices won't compile. Pin to ^0.17 so imago unifies
on libkrun's exact vm-memory.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 Cargo.toml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index 1d360cf..c078a9c 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -66,8 +66,13 @@ features = ["sync"]
 version = "0.1"
 features = ["attributes"]
 
+# limina: pin to the vm-memory version the whole libkrun stack uses (krun-arch/devices/hvf/vmm
+# all on ^0.17). Upstream's ">=0.16, <0.19" lets the resolver pick a semver-incompatible
+# vm-memory for imago (0.16 or 0.18) distinct from libkrun's 0.17, so the VolatileSlice handed
+# to imago's vm-memory I/O fails `ImagoAsRef` and krun-devices won't compile. Narrowing to ^0.17
+# forces unification.
 [dependencies.vm-memory]
-version = ">=0.16, <0.19"
+version = ">=0.17, <0.18"
 optional = true
 
 [dev-dependencies.tokio]
